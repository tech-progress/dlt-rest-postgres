# Local Compose; replace placeholders. Never commit .env.
POSTGRES_PASSWORD=
DLT_LOADER_PASSWORD=
SOURCE_BASE_URL=https://your-api.example/orders-api/
SOURCE_API_TOKEN=
ALLOW_INSECURE_SOURCE=false
# Runtime loader (Compose fills PG* from Postgres above).
PGHOST=postgres
PGPORT=5432
PGDATABASE=warehouse
PGUSER=dlt_loader
PGPASSWORD=
PGSSLMODE=prefer
SOURCE_ENDPOINT=orders
SOURCE_PAGE_SIZE=50
SOURCE_INITIAL_CURSOR=0
SOURCE_LOOKBACK_SECONDS=3600
PIPELINE_NAME=rest_orders
DATASET_NAME=rest_warehouse
PIPELINES_DIR=/tmp/dlt-pipelines
RUNTIME__DLTHUB_TELEMETRY=false
# Database service: initialization only, generated defaults on Railway.
PORT=5432
POSTGRES_DB=warehouse
POSTGRES_USER=postgres
PGDATA=/var/lib/postgresql/data/pgdata
# IaC authoring only: MUST be a real authorized repository and existing branch.
TEMPLATE_SOURCE_REPO=
TEMPLATE_SOURCE_BRANCH=
TEMPLATE_SOURCE_ROOT_DIR=/dlt-rest-postgres
